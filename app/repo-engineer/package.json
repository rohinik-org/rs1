{
  "name": "repo-engineer",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "assess": "./dist/commands/assess.js",
    "plan": "./dist/commands/plan.js",
    "approve": "./dist/commands/approve.js",
    "execute": "./dist/commands/execute.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/commands/assess.ts src/commands/plan.ts src/commands/approve.ts src/commands/execute.ts --format esm --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "*",
    "typescript": "*",
    "vitest": "*"
  }
}
