{
  "name": "@rohinik-org/install-manifest",
  "version": "0.16.0-beta.1",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Rohinik runtime install manifest schema, validator, and ROHINIK_HOME resolver",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "*",
    "typescript": "*",
    "vitest": "*"
  }
}
