{
  "name": "@rohinik-org/server",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "rhks": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts",
    "start": "node dist/bin.js",
    "test": "vitest run",
    "test:smoke": "vitest run --include '**/*.smoke.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rohinik-org/evaluation-ir": "workspace:*",
    "@rohinik-org/experience-ir": "workspace:*",
    "@rohinik-org/experience-query-ir": "workspace:*",
    "@rohinik-org/experience-store-ir": "workspace:*",
    "@rohinik-org/execution-ir": "workspace:*",
    "@rohinik-org/capability-manifest": "workspace:*",
    "@rohinik-org/kernel": "workspace:*",
    "@rohinik-org/planner-ir": "workspace:*",
    "@rohinik-org/runtime": "workspace:*",
    "@rohinik-org/working-context": "workspace:*",
    "@rohinik-org/prediction-ir": "workspace:*",
    "@rohinik-org/agent-ir": "workspace:*",
    "@rohinik-org/agent-runtime": "workspace:*",
    "@rohinik-org/agent-delegation": "workspace:*",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@rohinik-org/capability-core": "workspace:*",
    "@rohinik-org/mock-provider": "workspace:*",
    "@types/node": "^22.0.0",
    "tsup": "*",
    "typescript": "*",
    "vitest": "*"
  }
}
