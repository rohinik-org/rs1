  "cancellationPrecedencePolicy": {
    "raceRule": "CANCELLING durably committed before execute() returns wins over provider completion",
    "durableCommitSequence": [
      "validate not already terminal",
      "write state=CANCELLING to asyncRepo",
      "emit CANCELLATION_REQUESTED (intent, not terminal)",
      "return cancelAccepted:true"
    ],
    "preExecutionCheck": "if state===CANCELLING: write CANCELLED, emit EXECUTION_CANCELLED, skip provider",
    "postCompletionCheck": "if state===CANCELLING after provider returns: honour cancellation unless already CANCELLED",
    "postTerminalCancel": "returns cancelAccepted:false; state unchanged",
    "terminalEventForCancellation": "EXECUTION_CANCELLED only (not CANCELLATION_REQUESTED)"
  },
